<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CaptainsLog.ViewModels"
             xmlns:models="clr-namespace:CaptainsLog.DatabaseClasses.Items"  
             xmlns:picker="clr-namespace:Syncfusion.Maui.Picker;assembly=Syncfusion.Maui.Picker"
             x:Class="CaptainsLog.JournalPages.JournalPage"
             Title="JournalPage"
             x:DataType="vm:JournalViewModel"
             x:Name="JournalEditPge">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Profile Image -->
                <Image
                Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                x:Name="BoatImage"
                HeightRequest="185"
                Aspect="AspectFit"
                    Source="{Binding JournalPicturePath}">
                    <Image.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding PickPhotoCommand}" NumberOfTapsRequired="1" />
                    </Image.GestureRecognizers>
                </Image>

                <picker:SfDatePicker
                    Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                    HeightRequest="150"
                    Format="dd_MMM_yyyy"
                    BackgroundColor="White"
                    HorizontalOptions="Fill"
                    SelectedDate="{Binding JournalEntryDate, Mode=TwoWay}"
                    >
                    <picker:SfDatePicker.ColumnHeaderView >
                        <picker:DatePickerColumnHeaderView Background="White"/>
                    </picker:SfDatePicker.ColumnHeaderView>
                </picker:SfDatePicker>

                <Entry
                Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                x:Name="TitleEntry"
                Placeholder="Entry Title"
                FontAttributes="Bold"
                FontSize="Medium"
                Margin="0,10,0,0"
                Text="{Binding JournalTitle}"/>

                <Entry
                Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                Placeholder="Enter Location"
                Margin="0,10,0,0"
                Text="{Binding JournalLocation}"/>

                <Entry
                Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
                VerticalTextAlignment="Start"
                Placeholder="How was your day?"
                Margin="0,10,0,0"
                Text="{Binding JournalContent}"/>
            </Grid>

        </ScrollView>

        <!-- Fixed button area at bottom -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*">
            <Button Grid.Column="0"
                    Text="SAVE"
                    HorizontalOptions="Fill"
                    VerticalOptions="End" 
                    Command="{Binding SaveJournalEntryCommand}"/>
            <Button Grid.Column="1"
                    Text="Next Page"
                    HorizontalOptions="Fill"
                    VerticalOptions="End" 
                    Command="{Binding OpenJournalEntryPageCommand}"/>
        </Grid>

    </Grid>
</ContentPage>