<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaptainsLog.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="dotnet_bot.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a hovercraft number nine" />

            <Label
                Text="Skippers Log"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Button
                Text="Boat Profile" 
                SemanticProperties.Hint="Your boats profile"
                Clicked="OnBoatProfileClicked"
                HorizontalOptions="Fill" />

            <Button
                Text="Diesel Calculator" 
                SemanticProperties.Hint="Log your leisure and propulsion hours to see the actual percentages"
                Clicked="DieselCalcClicked"
                HorizontalOptions="Fill" />

            <Button
                Text="Boat Expenses" 
                SemanticProperties.Hint="Log your expenses to see how much it costs to run the boat"
                Clicked="BoatExpClicked"
                HorizontalOptions="Fill" />

        </VerticalStackLayout>


    </ScrollView>

</ContentPage>
