<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaptainsLog.BoatExpensesPages.ExpensesTopPage"
             Title="Expenses">
    <ContentPage.Content>
        <Border Padding="10,10">
            <Grid RowSpacing="6"
              ColumnSpacing="6">
                <!-- Define number of rows and columns -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="25"/>
                    <RowDefinition Height="50"/>
                   
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <!--Display Expenses Average in per week, month, year-->
                <Label Grid.Column="0"
                       Grid.ColumnSpan="6"
                       Grid.Row="0"
                       Text="Average Expenses"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                <Label Grid.Column="0"
                       Grid.ColumnSpan="6"
                       Grid.Row="1"
                       Text="0.00 per week"
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                <!-- Expenses Filter Title-->
                <Label Grid.Column="0"
                       Grid.ColumnSpan="6"
                       Grid.Row="2"
                       Text="Rate of Spending Filters"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                <!-- Weekly Button-->
                <Button Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Grid.Row="3"
                        Text="Per Week"
                        Clicked="OnWeeklyExpensesClicked"
                        HorizontalOptions="Fill"/>
                <!-- Monthly Button-->
                <Button Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Grid.Row="3"
                        Text="Per Month"
                        Clicked="OnMonthlyExpensesClicked"
                        HorizontalOptions="Fill"/>
                <!-- Yearly Button-->
                <Button Grid.Column="4"
                        Grid.ColumnSpan="2"
                        Grid.Row="3"
                        Text="Per Year"
                        Clicked="OnYearlyExpensesClicked"
                        HorizontalOptions="Fill"/>
                <!-- Update Controls-->
                <Label Grid.Column="0"
                       Grid.ColumnSpan="6"
                       Grid.Row="4"
                       Text="Update Buttons"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                <!-- Add Expense Button-->
                <Button Grid.Column="0"
                        Grid.ColumnSpan="3"
                        Grid.Row="5"
                        Text="Add Expense"
                        Clicked="OnAddExpenseClicked"
                        HorizontalOptions="Fill"/>
                <!-- View Expenses Button-->
                <Button Grid.Column="3"
                        Grid.ColumnSpan="3"
                        Grid.Row="5"
                        Text="View Expenses"
                        Clicked="OnViewExpensesClicked"
                        HorizontalOptions="Fill"/>

            </Grid>
        </Border>
    </ContentPage.Content>
</ContentPage>