<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:local="clr-namespace:CaptainsLog.BoatExpensesPages"
    x:TypeArguments="local:ExpenseResult"
    x:Class="CaptainsLog.BoatExpensesPages.EditExpensePopup">

    <ScrollView>
            <VerticalStackLayout Padding="4" Spacing="10">

                <Label
                    Text="Change Expense"
                    FontAttributes="Bold"
                    FontSize="18"
                    HorizontalOptions="Center"
                    Margin="0,4"/>

                <Picker
                    x:Name="TypePicker"
                    Title="Type"
                    HeightRequest="56"
                    FontSize="16"
                    Margin="0,2"
                    IsEnabled="True">
                    <Picker.ItemsSource>
                    <x:Array Type="{x:Type x:String}">
                        <x:String>Fuel (Petrol/Diesel)</x:String>
                            <x:String>Coal/Logs</x:String>
                            <x:String>Pumpout/Elsan</x:String>
                            <x:String>Gas</x:String>
                            <x:String>Engine Repair</x:String>
                            <x:String>Hull Maintenance</x:String>
                            <x:String>Other</x:String>
                        </x:Array>
                    </Picker.ItemsSource>
                </Picker>

                <Entry
                    x:Name="ExpenseDescEntry"
                    Placeholder="Note"
                    HeightRequest="56"
                    FontSize="16"
                    Margin="0,2"
                    IsEnabled="True"/>

                <Entry
                    x:Name="AmountEntry"
                    Placeholder="Amount"
                    Keyboard="Numeric"
                    HeightRequest="56"
                    FontSize="16"
                    Margin="0,2"
                    IsEnabled="True"/>

                <HorizontalStackLayout HorizontalOptions="End" Spacing="8" Margin="0,6,0,0">
                    <Button
                        Text="Save"
                        Clicked="OnSaveClicked"
                        FontSize="16"
                        IsEnabled="True"/>
                </HorizontalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

</toolkit:Popup>

