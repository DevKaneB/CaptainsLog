<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaptainsLog.DieselCalcPage"
             Title="Diesel Calculator">
    <ContentPage.Content>
        <Border Padding="10,10">
            <Grid RowSpacing="6"
                  ColumnSpacing="6">
                <!-- Define number of rows and columns -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="25" />
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="25" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <!-- Propulsion hours title Label -->
                <Label Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Grid.Row="0"
                       Text="Propulsion %" 
                       HorizontalOptions="Center"
                       VerticalOptions="Center" 
                       FontSize="Large"/>
                <!-- Propulsion hours output Label -->
                <Label
                    Grid.Column="1"
                    Grid.ColumnSpan="1"
                    Grid.Row="1"
                    x:Name="PropHrsLbl"
                    Text="0%"
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    FontSize="Large"/>

                <!-- Divider label -->
                <Label Grid.Column="2"
                       Grid.ColumnSpan="2"
                       Grid.Row="1"
                       Text=":"
                       HorizontalOptions="Center"
                       FontSize="Large"/>

                <!-- Leisure hours Title Label -->
                <Label Grid.Column="3"
                       Grid.ColumnSpan="3"
                       Grid.Row="0"
                       Text="Leisure %"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontSize="Large"/>
                <!-- Leisure hours output Label -->
                <Label
                    Grid.Column="4"
                    Grid.ColumnSpan="1"
                    Grid.Row="1"
                    x:Name="DiesHrsLbl"
                    Text="0%"                     
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    FontSize="Large"/>

                <!-- Litres Per Hour Label -->
                <Label
                    Grid.Column="0"
                    Grid.ColumnSpan="6"
                    Grid.Row="2"
                    x:Name="LitrePHourLbl"
                    Text="0 Litres/Hour"                     
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    FontSize="Medium"/>     

                <!-- Litres per Hour Description -->
                <Label
                    Grid.Column="0"
                    Grid.ColumnSpan="6"
                    Grid.Row="3"
                    Text="used since last refill"                     
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    FontSize="Medium"/>      

                
                <!-- Refresh Buttons Description -->
                <Label
                    Grid.Column="0"
                    Grid.ColumnSpan="6"
                    Grid.Row="4"
                    Text="Press to refresh the display"                     
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    FontSize="Medium"
                    BackgroundColor="LightGrey"/>


                <!-- View Percentages since last refill -->
                <Button
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="5"
                    x:Name="LastRefillBtn"
                    Text="Last Refuel"
                    FontAutoScalingEnabled="True"
                    SemanticProperties.Hint="View Percentages since last refill"
                    Clicked="OnLastRefillClicked"
                    HorizontalOptions="Fill" />
                <!-- View Percentages last 30 days -->
                <Button
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    Grid.Row="5"
                    x:Name="LastThirtyDaysBtn"
                    Text="Last 30 Days" 
                    SemanticProperties.Hint="View Percentages over the last 30 days"
                    Clicked="OnLastThirtyDaysClicked"
                    HorizontalOptions="Fill" />
                <!-- View Percentages AllTime -->
                <Button
                    Grid.Column="4"
                    Grid.ColumnSpan="2"
                    Grid.Row="5"
                    x:Name="AllTimeBtn"
                    Text="All Time" 
                    SemanticProperties.Hint="View Percentages of All Time"
                    Clicked="OnAllTimeClicked"
                    HorizontalOptions="Fill" />
                <!-- Refresh Buttons Description -->
                <Label
                    Grid.Column="0"
                    Grid.ColumnSpan="6"
                    Grid.Row="6"
                    Text="Update the Database"                     
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    FontSize="Medium"
                    BackgroundColor="LightGrey"/>
                <!-- Add or Update Hours -->
                <Button
                    Grid.Column="0"
                    Grid.ColumnSpan="6"
                    Grid.Row="7"
                    x:Name="AddUpdateHoursBtn"
                    Text="Add/Update Hours" 
                    SemanticProperties.Hint="Add Hours or update current hours"
                    Clicked="OnAddUpdateHoursClicked"
                    HorizontalOptions="Fill" />
                <!-- Add a diesel Refill -->
                <Button
                    Grid.Column="0"
                    Grid.ColumnSpan="6"
                    Grid.Row="8"
                    x:Name="DieselRefillBtn"
                    Text="Add a Diesel Refill" 
                    SemanticProperties.Hint="Add diesel refill by litres and date"
                    Clicked="OnDieselRefillClicked"
                    HorizontalOptions="Fill" />
                <!-- View History Log -->
                <Button
                    Grid.Column="0"
                    Grid.ColumnSpan="6"
                    Grid.Row="9"
                    x:Name="ViewHistoryBtn"
                    Text="View All Entries" 
                    SemanticProperties.Hint="View History for the last year"
                    Clicked="OnViewHistoryClicked"
                    HorizontalOptions="Fill" />


            </Grid>
        </Border>
    </ContentPage.Content>
</ContentPage>