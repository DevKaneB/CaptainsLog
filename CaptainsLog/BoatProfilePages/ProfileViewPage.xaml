<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CaptainsLog.ViewModels"
             xmlns:models="clr-namespace:CaptainsLog.DatabaseClasses"
             x:Class="CaptainsLog.BoatProfilePages.ProfileViewPage"
             Title="Boat Profile"
             x:Name="ProfileViewContentPage"
             x:DataType="vm:ProfilePageModel">

    <CollectionView ItemsSource="{Binding ProfileItems}" Background="Transparent" >
    <CollectionView.ItemTemplate>
        <DataTemplate x:DataType="models:ProfileItem">
            <ScrollView>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <!--Boat Name-->
                    <Label
                        Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                        Text="{Binding BoatName}" 
                        HorizontalTextAlignment="Center"
                        FontSize="36"/>
                    
                    <!-- Profile Image -->
                    <Image
                        Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                        x:Name="BoatImage"
                        Source="{Binding ImageSource}"
                        HeightRequest="185"
                        Aspect="AspectFit">
                    </Image>

                    <!-- Boat Metric-->
                    <Label 
                        Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
                        Text="Boat Metrics" 
                        FontSize="Header" 
                        HorizontalTextAlignment="Center"/>

                    <!--Registration Number-->
                    <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4"
                        Text="Registration Number" 
                        HorizontalTextAlignment="Center"/>
                    
                    <Label 
                        Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                        Text="{Binding RegNumber}" 
                        HorizontalTextAlignment="Center" />

                    <!--Build Year -->
                    <Label 
                        Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                        Text="Build Year" 
                        HorizontalTextAlignment="Center" />

                    <Label 
                        Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                        Text="{Binding BuildYear}" 
                        HorizontalTextAlignment="Center" /> 
                    
                    <!--Boat Length -->
                    <Label 
                        Grid.Row="5" Grid.Column="2" Grid.ColumnSpan="2"
                        Text="Length(ft)" 
                        HorizontalTextAlignment="Center"/>

                    <Label 
                        Grid.Row="6" Grid.Column="2" Grid.ColumnSpan="2"
                        Text="{Binding Length}" 
                        HorizontalTextAlignment="Center"/>


                    <!--Boat Beam -->
                    <Label 
                        Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2"
                        Text="Beam(ft)" HorizontalTextAlignment="Center"/>

                    <Label 
                        Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2"
                        Text="{Binding Beam}" HorizontalTextAlignment="Center"/>


                    <!--Boats Draught-->
                    <Label Grid.Row="7" Grid.Column="2" Grid.ColumnSpan="2"
                        Text="Draught(ft)" HorizontalTextAlignment="Center"/>

                    <Label Grid.Row="8" Grid.Column="2" Grid.ColumnSpan="2"
                        Text="{Binding Draft}" HorizontalTextAlignment="Center"/>



                    <!--Re-occuring bills and stuff-->
                    <Label Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="4"
                           Text="Expiry Dates" 
                           FontSize="Header" 
                           HorizontalTextAlignment="Center"/>
                    
                    <!--Licence Expiry Date-->
                    <Label Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Licence" 
                           HorizontalTextAlignment="Center"/>

                    <Label Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding LicenseExpiryDate}" 
                           HorizontalTextAlignment="Center"/>

                    <!--Insurance Expiry Date-->
                    <Label Grid.Row="10" Grid.Column="2" Grid.ColumnSpan="2"
                           Text="Insurance" 
                           HorizontalTextAlignment="Center"/>

                    <Label Grid.Row="11" Grid.Column="2" Grid.ColumnSpan="2"
                           Text="{Binding InsuranceExpiryDate}" 
                           HorizontalTextAlignment="Center"/>

                    <!--BSS expiry Date-->
                    <Label Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="4"
                           Text="BSS" 
                           HorizontalTextAlignment="Center"/>

                   
                    <Label Grid.Row="13" Grid.Column="0" Grid.ColumnSpan="4"
                           Text="{Binding BSSExpiryDate}" 
                           HorizontalTextAlignment="Center"/>


                    <!--Service Intervals -->
                    <Label Grid.Row="14" Grid.Column="0" Grid.ColumnSpan="4"
                           Text="Service Intervals" 
                           FontSize="Header" 
                           HorizontalTextAlignment="Center"/>
                    
                    <!--Enter Service Hours-->
                    <Label Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="Engine Interval Hours" 
                           HorizontalTextAlignment="Center"/>

                    <Label Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="2"
                           Text="{Binding EngineServiceIntervalHours}" 
                           HorizontalTextAlignment="Center"/>

                    <!--Enter Service Hours-->
                    <Label Grid.Row="15" Grid.Column="2" Grid.ColumnSpan="2"
                           Text="Hours Remaining" 
                           HorizontalTextAlignment="Center"/>

                    <Label Grid.Row="16" Grid.Column="2" Grid.ColumnSpan="2"
                           Text="Fix" 
                           HorizontalTextAlignment="Center"/>

                    <!--Enter last service Date-->
                    <Label Grid.Row="17" Grid.Column="0" Grid.ColumnSpan="4"
                           Text="Last Service Date" 
                           HorizontalTextAlignment="Center"/>

                    <Label Grid.Row="18" Grid.Column="0" Grid.ColumnSpan="4"
                          Text="{Binding LastServiceDate}" 
                          HorizontalTextAlignment="Center"/>


                    <Label Grid.Row="19" Grid.Column="0" Grid.ColumnSpan="4"
                           Text="The Last Service Date will be used to calculate how many hours have been used via the Diesel Calculator" 
                           HorizontalTextAlignment="Center"/>

                    <Button Grid.Row="20" Grid.Column="0" Grid.ColumnSpan="4"
                            Text="Edit Profile" 
                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenEditPageCommand}"/>

                </Grid>
            </ScrollView>

        </DataTemplate>
    </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>