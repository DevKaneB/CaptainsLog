<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CaptainsLog.DieselLogPage"
             Title="Diesel Useage Log">
    <CollectionView x:Name="listDatabaseItems" 
                    Background="Transparent" 
                    >
        <CollectionView.ItemTemplate>
            <DataTemplate >
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition Height="20"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0" Grid.Row="0" Text="Date" BackgroundColor="AliceBlue" HorizontalTextAlignment="Center"/>
                    <Label Grid.Column="0" Grid.Row="1" Text="{Binding EntryDate, StringFormat='\{0:dd-MMM-yyyy\}'}" HorizontalTextAlignment="Center"/>

                    <Label Grid.Column="1" Grid.Row="0" Text="Leisure Hours" FontAttributes="Bold" BackgroundColor="AliceBlue" HorizontalTextAlignment="Center"/>
                    <Label Grid.Column="1" Grid.Row="1" Text="{Binding LeisureHours}" HorizontalTextAlignment="Center"/>

                    <Label Grid.Column="2" Grid.Row="0" Text="Prop Hours" FontAttributes="Bold" BackgroundColor="AliceBlue" HorizontalTextAlignment="Center"/>
                    <Label Grid.Column="2" Grid.Row="1" Text="{Binding PropHours}" HorizontalTextAlignment="Center"/>

                    <Label Grid.Column="3" Grid.Row="0" Text="Diesel Litres" FontAttributes="Bold" BackgroundColor="AliceBlue" HorizontalTextAlignment="Center"/>
                    <Label Grid.Column="3" Grid.Row="1" Text="{Binding DieselRefill}" HorizontalTextAlignment="Center"/>

                    <Button
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Grid.Row="3"
                        x:Name="DeleteRowBtn"
                        Text="Delete Entry" 
                        SemanticProperties.Hint="Delete this entry"
                        Clicked="OnDeleteRowClicked"
                        HorizontalOptions="Fill" />


                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
                
           
    </CollectionView>
</ContentPage>