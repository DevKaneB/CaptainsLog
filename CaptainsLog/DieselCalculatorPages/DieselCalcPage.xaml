<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             x:Class="CaptainsLog.DieselCalcPage"
             Title="Diesel Calculator"
             Shell.NavBarIsVisible="False"
            ios:Page.UseSafeArea="true"
            BackgroundColor="#A7CFCF">
    <ContentPage.Content>
        <Border Padding="10,10">
            <Grid RowSpacing="6"
                  ColumnSpacing="6">
                <!-- Define number of rows and columns -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="55" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="15" />
                    <RowDefinition Height="30"/>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <ImageButton Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" 
                             Clicked="OnBackButtonClicked"
                             Source="backbutton.png"
                             HorizontalOptions="Fill"/>

                <ImageButton Grid.Row="0" Grid.Column="5" Grid.ColumnSpan="1" 
                             Clicked="OnHelpButtonClicked"
                             Source="helpbutton.png"
                             HorizontalOptions="Fill"/>  

                <!-- Propulsion hours title Label -->
                <Label Grid.Column="0"
                       Grid.ColumnSpan="3"
                       Grid.Row="2"
                       Text="Propulsion %" 
                       TextColor="Black"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" 
                       FontSize="Title"/>
                <!-- Propulsion hours output Label -->
                <Label
                    Grid.Column="1"
                    Grid.ColumnSpan="1"
                    Grid.Row="3"
                    x:Name="PropHrsLbl"
                    TextColor="Black"
                    Text="0%"
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    FontSize="Large"/>

                <!-- Divider label -->
                <Label Grid.Column="2"
                       Grid.ColumnSpan="2"
                       Grid.Row="3"
                       Text=":"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       FontSize="Large"/>

                <!-- Leisure hours Title Label -->
                <Label Grid.Column="3"
                       Grid.ColumnSpan="3"
                       Grid.Row="2"
                       Text="Leisure %"
                       TextColor="Black"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       FontSize="Title"/>
                <!-- Leisure hours output Label -->
                <Label
                    Grid.Column="4"
                    Grid.ColumnSpan="1"
                    Grid.Row="3"
                    x:Name="DiesHrsLbl"
                    TextColor="Black"
                    Text="0%"                     
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    FontSize="Large"/>

                <!-- Litres Per Hour Label -->
                <Label
                    Grid.Column="0"
                    Grid.ColumnSpan="6"
                    Grid.Row="4"
                    x:Name="LitrePHourLbl"
                    Text="0 Litres/Hour"  
                    TextColor="Black"
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    FontSize="Medium"/>     

                <!-- View Percentages since last refill -->
                <Button
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="5"
                    x:Name="LastRefillBtn"
                    Text="Last Refuel"
                    TextColor="White"
                    FontAutoScalingEnabled="True"
                    SemanticProperties.Hint="View Percentages since last refill"
                    Clicked="OnLastRefillClicked"
                    HorizontalOptions="Fill" 
                    BackgroundColor="#226666"
                    BorderColor="Black"
                    BorderWidth="3"/>
                <!-- View Percentages last 30 days -->
                <Button
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    Grid.Row="5"
                    x:Name="LastThirtyDaysBtn"
                    Text="Last 30 Days" 
                    TextColor="White"
                    SemanticProperties.Hint="View Percentages over the last 30 days"
                    Clicked="OnLastThirtyDaysClicked"
                    HorizontalOptions="Fill" 
                    BackgroundColor="#226666"
                    BorderColor="Black"
                    BorderWidth="3"/>
                <!-- View Percentages AllTime -->
                <Button
                    Grid.Column="4"
                    Grid.ColumnSpan="2"
                    Grid.Row="5"
                    x:Name="AllTimeBtn"
                    Text="All Time" 
                    TextColor="White"
                    SemanticProperties.Hint="View Percentages of All Time"
                    Clicked="OnAllTimeClicked"
                    HorizontalOptions="Fill" 
                    BackgroundColor="#226666"
                    BorderColor="Black"
                    BorderWidth="3"/>
                <!-- Refresh Buttons Description -->
                <Label
                    Grid.Column="0"
                    Grid.ColumnSpan="6"
                    Grid.Row="7"
                    Text="Database Management"  
                    TextColor="Black"
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    FontSize="Subtitle"/>
                <!-- Add or Update Hours -->
                <Button
                    Grid.Column="0"
                    Grid.ColumnSpan="6"
                    Grid.Row="8"
                    x:Name="AddUpdateHoursBtn"
                    Text="Add/Update Hours" 
                    SemanticProperties.Hint="Add Hours or update current hours"
                    Clicked="OnAddUpdateHoursClicked"
                    HorizontalOptions="Fill" 
                    BackgroundColor="#226666"
                    TextColor="White"
                    BorderWidth="3"/>
                <!-- Add a diesel Refill -->
                <Button
                    Grid.Column="0"
                    Grid.ColumnSpan="6"
                    Grid.Row="9"
                    x:Name="DieselRefillBtn"
                    Text="Add a Diesel Refill" 
                    SemanticProperties.Hint="Add diesel refill by litres and date"
                    Clicked="OnDieselRefillClicked"
                    HorizontalOptions="Fill" 
                    BackgroundColor="#226666"
                    TextColor="White"
                    BorderWidth="3"/>
                <!-- View History Log -->
                <Button
                    Grid.Column="0"
                    Grid.ColumnSpan="6"
                    Grid.Row="10"
                    x:Name="ViewHistoryBtn"
                    Text="View All Entries" 
                    SemanticProperties.Hint="View History for the last year"
                    Clicked="OnViewHistoryClicked"
                    HorizontalOptions="Fill" 
                    BackgroundColor="#226666"
                    TextColor="White"
                    BorderWidth="3"/>


            </Grid>
        </Border>
    </ContentPage.Content>
</ContentPage>